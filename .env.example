# Salin ke .env untuk jalan lokal. Di EasyPanel isi lewat tab Environment.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/bertumbuh
# minimal 32 karakter acak (mis. `openssl rand -hex 32`)
SESSION_SECRET=
# URL publik app (https, tanpa slash di akhir). Dipakai untuk link pengembalian di WA dan cookie aman.
APP_URL=https://bertumbuh.domainmu.com
# WAHA (WhatsApp HTTP API) milikmu
WAHA_URL=https://waha.domainmu.com
WAHA_API_KEY=
WAHA_SESSION=default
# Password sementara awal untuk 2 admin & default saat daftar massal / reset password
DEFAULT_PASSWORD=
# Rahasia untuk memanggil /api/cron/reminders dari luar (opsional, tapi wajib diisi supaya endpoint aktif)
CRON_SECRET=
# Opsional: jeda acak antar pesan WA (ms), default 3000-9000
# REMINDER_DELAY_MIN_MS=3000
# REMINDER_DELAY_MAX_MS=9000
# Opsional: set 1 untuk mematikan scheduler internal (mis. kalau pakai cron eksternal saja)
# DISABLE_SCHEDULER=1
