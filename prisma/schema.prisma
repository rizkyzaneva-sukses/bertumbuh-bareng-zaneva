generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MEMBER
}

enum LoanStatus {
  DIPINJAM
  TERLAMBAT
  DIKEMBALIKAN
}

enum ReturnedVia {
  LINK
  USER
  ADMIN
}

enum ReminderKind {
  FIRST_LINK
  FOLLOW_UP
}

enum ReminderStatus {
  PENDING
  SENT
  FAILED
}

/// Kondisi fisik sebuah eksemplar saat dikembalikan.
enum BookCondition {
  BAIK
  RUSAK_RINGAN
  RUSAK_BERAT
  HILANG
}

/// Status bacaan. Ini BUKAN status pinjaman: buku bisa sudah dikembalikan
/// tapi orangnya belum selesai baca (atau sebaliknya).
enum ReadingStatus {
  SEDANG_DIBACA
  SELESAI
}

/// Pertanyaan yang dikirim ke WhatsApp dan menunggu balasan angka.
enum PromptKind {
  AFTER_RETURN
}

/// Pertanyaan WA yang menunggu jawaban anggota ("1" = beres, "2" = belum).
///
/// Dipakai untuk tahu **beres baca**, bukan cuma "buku sudah kembali".
/// Jawaban dibaca lewat polling WAHA (bukan webhook) supaya tidak mengganggu
/// webhook n8n yang sudah terpasang di sesi `tehayu`.
model WaPrompt {
  id         String      @id @default(cuid())
  userId     String
  bookId     String
  loanId     String?
  kind       PromptKind  @default(AFTER_RETURN)
  createdAt  DateTime    @default(now())
  /// Null = belum terkirim (job yang mengirim, biar request balikin tetap cepat).
  sentAt     DateTime?
  expiresAt  DateTime
  answeredAt DateTime?
  /// "1" atau "2"
  answer     String?
  /// Teks balasan yang tertangkap, untuk jejak audit.
  replyText  String?
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  book       Book        @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([userId, answeredAt])
  @@index([sentAt, answeredAt])
}

model User {
  id                 String   @id @default(cuid())
  name               String
  /// Nomor HP ternormalisasi, format 62812xxxx (tanpa +). Ini username.
  phone              String   @unique
  passwordHash       String
  /// Password sementara (plain) supaya admin bisa membagikannya. Dihapus saat user ganti password.
  tempPassword       String?
  role               Role     @default(MEMBER)
  mustChangePassword Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  loans              Loan[]
  progresses         ReadingProgress[]
  waPrompts          WaPrompt[]
  bookRequests       BookRequest[]
  pushSubscriptions  PushSubscription[]
  readingLogs        ReadingLog[]
}

model Book {
  id        String   @id @default(cuid())
  title     String
  author    String
  pages     Int?
  category  String   @default("")
  synopsis  String   @default("")
  /// Jumlah eksemplar
  stock     Int      @default(1)
  /// URL/path gambar sampul (2:3). Kosong = rak memakai sampul generatif
  /// (tipografi bergaya toko buku, bukan cuma judul teks polos).
  coverUrl  String   @default("")
  /// Kapan buku diarsipkan. Null = masih di rak.
  ///
  /// Bos: *"Sekalian tambahkan fitur arsipkan buku, takutnya saya butuh buat
  /// pribadi"*. Arsip = buku DISIMPAN, bukan dihapus: hilang dari rak anggota,
  /// tidak bisa dipinjam, tapi sampul + seluruh riwayat pinjam/bacanya utuh dan
  /// bisa dikembalikan ke rak kapan saja. Berbeda dari Hapus yang memusnahkan
  /// riwayat.
  archivedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  loans     Loan[]
  progresses ReadingProgress[]
  readingLogs ReadingLog[]
  waPrompts  WaPrompt[]
  cover     BookCover?

  @@index([title])
  @@index([archivedAt])
}

/// Gambar sampul hasil unggahan admin, disimpan di DB (bukan di disk) supaya
/// tidak butuh volume permanen dan tidak hilang saat container di-deploy ulang.
/// Satu buku satu sampul; `Book.coverUrl` menunjuk ke `/api/books/<id>/cover`.
model BookCover {
  bookId    String   @id
  mime      String
  bytes     Bytes
  width     Int?
  height    Int?
  updatedAt DateTime @updatedAt
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
}

/// Progres baca per ORANG per BUKU, bukan per peminjaman.
///
/// Bos: "saya baca Buku A sampai 200, eh kepotong mau buku B 100 hal, eh
/// keburu ke buku C — jadi nanti saya bisa lanjut lagi". Karena itu progres
/// menempel ke (user, buku) dan selamat walau bukunya sudah dikembalikan atau
/// dipinjam ulang nanti.
model ReadingProgress {
  id         String        @id @default(cuid())
  userId     String
  bookId     String
  /// Halaman terakhir yang dibaca (0 = belum mulai).
  lastPage   Int           @default(0)
  /// Jumlah halaman buku saat progres dicatat (jaga-jaga kalau `pages` diedit admin).
  totalPages Int?
  status     ReadingStatus @default(SEDANG_DIBACA)
  /// Kapan ditandai "beres baca". Null = belum beres.
  finishedAt DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  book       Book          @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId])
  @@index([userId, status])
  @@index([bookId])
}

model Loan {
  id          String       @id @default(cuid())
  userId      String
  bookId      String
  borrowedAt  DateTime     @default(now())
  /// Tanggal jatuh tempo (tanggal kalender WIB, disimpan sebagai DATE)
  dueDate     DateTime     @db.Date
  returnedAt  DateTime?
  returnedVia ReturnedVia?
  status      LoanStatus   @default(DIPINJAM)
  /// Nonce untuk link pengembalian sekali pakai. Null = tidak ada link aktif.
  returnNonce String?
  /// Kondisi buku saat dikembalikan. Null = belum dikembalikan / belum dicatat.
  condition   BookCondition?
  /// Catatan bebas admin soal kondisi (mis. "halaman 12 sobek").
  conditionNote String?
  /// Berapa kali pinjaman ini diperpanjang. Maksimum ditentukan RENEW_LIMIT.
  renewCount  Int          @default(0)
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  book        Book         @relation(fields: [bookId], references: [id], onDelete: Cascade)
  reminders   ReminderLog[]
  proof       ReturnProof?

  @@index([userId, status])
  @@index([bookId, status])
  @@index([status, dueDate])
}

/// Foto bukti saat buku dikembalikan.
///
/// Peminjam memotret buku yang sudah diletakkan di rak / meja pengembalian.
/// Ini menutup celah "saya sudah balikin kok masih ditagih": buktinya ada,
/// bisa dibuka lagi kapan saja.
///
/// Satu peminjaman satu bukti. Disimpan di DB (pola sama dengan BookCover)
/// supaya tidak butuh volume permanen dan tidak hilang saat redeploy.
model ReturnProof {
  loanId    String   @id
  mime      String   @default("image/jpeg")
  bytes     Bytes
  width     Int?
  height    Int?
  /// Ukuran berkas setelah dikompres (byte). Dipakai untuk memantau storage.
  sizeBytes Int      @default(0)
  createdAt DateTime @default(now())
  loan      Loan     @relation(fields: [loanId], references: [id], onDelete: Cascade)
}

model ReminderLog {
  id        String         @id @default(cuid())
  loanId    String
  /// Tanggal kalender WIB (YYYY-MM-DD) saat pengingat dikirim
  sentOn    String
  kind      ReminderKind
  status    ReminderStatus @default(PENDING)
  attempts  Int            @default(0)
  message   String         @default("")
  error     String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  loan      Loan           @relation(fields: [loanId], references: [id], onDelete: Cascade)

  @@unique([loanId, sentOn])
  @@index([createdAt])
}

model Setting {
  key   String @id
  value String
}

/// Catatan baca HARIAN — satu baris per orang, per buku, per tanggal.
///
/// Bos: *"semua karyawan wajib baca buku setiap harinya ... saya ingin di
/// dashboard admin terlihat si A hari ini baca berapa halaman dan bukunya apa"*.
///
/// Kenapa tabel terpisah, bukan cuma `ReadingProgress.lastPage`:
/// `lastPage` hanya menyimpan POSISI terakhir. Kalau Budi hari ini baca 10
/// halaman lalu besok membuka app lagi dan mengisi angka yang sama, tidak ada
/// jejak "hari ini 10 halaman" — posisi memang tidak berubah. Dengan log harian,
/// setiap perubahan posisi menghasilkan catatan tanggal, jadi pertanyaan "hari
/// ini dia baca berapa halaman" bisa dijawab per hari.
///
/// `pagesRead` dihitung dari selisih halaman (delta), BUKAN posisi. Kalau orang
/// memperbaiki angka ke bawah, delta-nya diabaikan (0) supaya tidak pernah ada
/// halaman negatif yang merusak total.
model ReadingLog {
  id         String   @id @default(cuid())
  userId     String
  bookId     String
  /// Tanggal kalender WIB (YYYY-MM-DD). String, bukan DateTime, supaya
  /// pengelompokan "hari ini" tidak terpengaruh zona waktu server.
  dayKey     String
  /// Jumlah halaman yang benar-benar dibaca pada hari itu.
  pagesRead  Int      @default(0)
  /// Posisi halaman saat log ini ditulis (untuk jejak audit / grafik).
  lastPage   Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  book       Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId, dayKey])
  @@index([dayKey])
  @@index([userId, dayKey])
}

/// Permintaan buku dari anggota.
///
/// Bos: karyawan minta buku lewat bot WA, lalu bot merekap di app supaya admin
/// tinggal lihat satu daftar — tidak perlu scroll chat WA satu per satu.
/// Cukup judul; link Shopee/URL opsional (membantu admin cek harga & edisi).
/// `phone` disimpan sebagai cadangan kalau pengirimnya bukan anggota terdaftar,
/// supaya usulan dari nomor luar app tidak hilang.
enum RequestStatus {
  BARU
  DIPERTIMBANGKAN
  DIBELI
  DITOLAK
}

model BookRequest {
  id        String        @id @default(cuid())
  /// Null = pengirimnya bukan anggota terdaftar (dicatat lewat `phone`).
  userId    String?
  phone     String
  /// Nama pengirim apa adanya (dari WA / profil).
  name      String        @default("")
  title     String
  /// Link Shopee / toko lain. Opsional — Bos: "atau judul buku aja juga cukup".
  url       String        @default("")
  /// Catatan bebas dari pengirim.
  note      String        @default("")
  /// "WA" = masuk lewat bot, "APP" = diketik di app.
  source    String        @default("WA")
  status    RequestStatus @default(BARU)
  /// Teks asli pesan WA, untuk jejak audit kalau parsing salah.
  rawText   String        @default("")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  user      User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([userId])
}

/// Langganan Web Push per perangkat.
///
/// Satu user boleh punya banyak baris (HP + laptop). `endpoint` unik: kalau
/// perangkat pindah tangan (logout A, login B), kepemilikan DIPINDAHKAN lewat
/// upsert — bukan digandakan. Endpoint yang dibalas 404/410 oleh FCM/APNs
/// dihapus otomatis saat kirim, supaya tabel tidak menumpuk sampah.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  /// URL endpoint dari browser — unik per perangkat.
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
